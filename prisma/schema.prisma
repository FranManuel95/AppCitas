// AppCitas — schema multi-tenant genérico para agendación de citas.
// Nota de portabilidad: se usan String en lugar de enums nativos porque SQLite
// (entorno de desarrollo) no los soporta. Los valores válidos están tipados en
// src/lib/domain/types.ts. En PostgreSQL pueden migrarse a enums nativos.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  // Fecha de nacimiento (opcional, la aporta el cliente): habilita el
  // segmento de campañas "cumpleaños próximos".
  birthDate    DateTime?
  // CLIENT | OWNER | STAFF | SUPER_ADMIN
  role         String  @default("CLIENT")
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id])

  emailVerifiedAt DateTime?

  // Cuenta sombra creada al reservar como invitado o al apuntar el negocio una
  // cita de mostrador: sin contraseña utilizable. Se "reclama" (guest: false)
  // demostrando la posesión del email vía el flujo de restablecer contraseña.
  guest Boolean @default(false)

  // Evidencia de consentimiento: instante en que aceptó los términos y la
  // política de privacidad al registrarse (RGPD, prueba del consentimiento).
  consentedAt DateTime?

  // Incrementarlo invalida todas las sesiones emitidas (revocación de JWT)
  sessionVersion Int @default(0)

  // 2FA TOTP (app de autenticación). El secreto se guarda al INICIAR la
  // activación y solo cuenta como activo cuando totpEnabledAt no es null
  // (el usuario demostró que su app genera códigos válidos).
  totpSecret    String?
  totpEnabledAt DateTime?
  // Códigos de recuperación de un solo uso (JSON de hashes SHA-256): la
  // salida de emergencia si se pierde el dispositivo del 2FA. Cada código
  // consumido se elimina de la lista.
  totpRecoveryCodes String?

  // Cliente de la pasarela de pagos (Stripe) si guardó tarjeta
  stripeCustomerId String?

  appointments Appointment[] @relation("ClientAppointments")
  reviews      Review[]
  authTokens   AuthToken[]
  // Ficha de empleado vinculada (portal del empleado, rol STAFF)
  staffProfile StaffMember?
  packages     ClientPackage[]
  auditLogs    AuditLog[]
  waitlist     WaitlistEntry[]
  clientNotes  ClientNote[]
  pushSubscriptions PushSubscription[]
  loyaltyCards LoyaltyCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

// Tokens de un solo uso para verificación de email, restablecimiento de
// contraseña e invitaciones de empleados. Se guarda solo el hash SHA-256.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  // EMAIL_VERIFY | PASSWORD_RESET
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Business {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  // Etiqueta libre de sector ("general", "peluquería", "clínica"...). El core
  // no depende de ella: permite especializar el proyecto base sin refactor.
  category    String  @default("general")
  timezone    String  @default("Europe/Madrid")
  currency    String  @default("EUR")
  address     String?
  phone       String?
  email       String?

  // Política de reservas y cancelación (configurable por negocio)
  cancellationWindowHours    Int @default(24)
  lateCancellationFeePercent Int @default(100)
  slotGranularityMinutes     Int @default(15)
  maxAdvanceBookingDays      Int @default(60)
  minNoticeMinutes           Int @default(60)

  // Pagos: exigir tarjeta guardada para reservar (permite cobrar cancelaciones
  // tardías automáticamente). Requiere pasarela configurada.
  requireCardToBook Boolean @default(false)

  // Feed iCal privado de la agenda (Google Calendar/Outlook por URL).
  // null = desactivado; regenerarlo revoca la URL anterior.
  icsFeedToken String? @unique

  // Marca en la página pública y el widget: color de acento (hex) y logo
  // (URL https externa; la app no aloja archivos)
  brandColor String?
  logoUrl    String?

  // Facturación fiscal: emitir facturas numeradas correlativas por los cobros
  // de citas. Solo activable con taxId relleno (se valida en Ajustes).
  invoicingEnabled Boolean @default(false)

  // Señal (prepago) al reservar: % del precio que se cobra en el momento con
  // la tarjeta guardada (0 = sin señal). Se reembolsa si se cancela en plazo y
  // se descuenta del cargo por cancelación tardía / no-show. Tiene sentido
  // junto a requireCardToBook (sin tarjeta guardada no hay señal que cobrar).
  depositPercent Int @default(0)

  // Descuento de última hora: % aplicado automáticamente a reservas que
  // empiezan en menos de 24 h (0 = desactivado). Llena huecos que se quedarían
  // vacíos (cancelaciones tardías); no se acumula con cupones ni bonos.
  lastMinuteDiscountPercent Int @default(0)

  // Visibilidad en el marketplace: si es false, el negocio no aparece en la
  // landing, la búsqueda ni el sitemap — su página pública solo es accesible
  // por enlace directo/QR. "Tus clientes son tuyos": modo agenda privada.
  listedInMarketplace Boolean @default(true)

  // Recordatorios y canales de notificación
  remindersEnabled    Boolean @default(true)
  reminderHoursBefore Int     @default(26)
  // Segundo recordatorio más cercano a la cita (null = desactivado)
  reminder2HoursBefore Int?
  // Cierre automático: las citas CONFIRMED con fin pasado se marcan
  // COMPLETED tras 24 h (NO_SHOW sigue siendo decisión manual del negocio)
  autoCompleteEnabled Boolean @default(true)
  notifyByEmail       Boolean @default(true)
  notifyBySms         Boolean @default(false)
  notifyByWhatsapp    Boolean @default(true)
  // Textos propios de los mensajes al cliente (JSON: por clave de plantilla,
  // override opcional de subject/body con variables {cliente} {negocio}
  // {servicio} {fecha} {hora} {precio} {enlace}). null = textos por defecto.
  notificationTemplates String?

  active Boolean @default(true)

  // Suscripción SaaS: qué paga el NEGOCIO a la plataforma (distinto del cobro
  // B2C de cancelaciones a sus clientes). plan: free|pro; subscriptionStatus:
  // trialing|active|past_due|canceled. Por defecto free/canceled (sin
  // suscripción); register-business fija pro/trialing +14d en el alta real. Los
  // IDs de Stripe son de la suscripción del negocio (no confundir con
  // User.stripeCustomerId, del cliente final).
  plan                         String    @default("free")
  subscriptionStatus           String    @default("canceled")
  trialEndsAt                  DateTime?
  planRenewsAt                 DateTime?
  platformStripeCustomerId     String?
  platformStripeSubscriptionId String?

  // Stripe Connect: cuenta conectada del negocio para RECIBIR los cobros B2C
  // (no-show/cancelación) directamente en su banco. Sin cuenta activa, el cargo
  // cae en la cuenta de la plataforma (comportamiento anterior).
  // stripeAccountStatus: none|pending|active. chargesEnabled lo marca Stripe
  // cuando la cuenta ya puede aceptar cobros (webhook account.updated).
  stripeAccountId      String?
  stripeAccountStatus  String  @default("none")
  stripeChargesEnabled Boolean @default(false)

  // Facturación de recibos: NIF/CIF y % de IVA a desglosar (0 = sin desglose)
  taxId      String?
  taxPercent Int     @default(0)

  users          User[]
  services       Service[]
  hours          BusinessHour[]
  closures       Closure[]
  appointments   Appointment[]
  staff          StaffMember[]
  notifications  Notification[]
  coupons        Coupon[]
  packages       Package[]
  clientPackages ClientPackage[]
  reviews        Review[]
  waitlist       WaitlistEntry[]
  clientNotes    ClientNote[]
  campaigns      Campaign[]
  invoicesIssued Invoice[]
  loyaltyProgram LoyaltyProgram?
  loyaltyCards   LoyaltyCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tarjeta de sellos: cada N citas completadas, un cupón personal de premio.
// El programa es 1:1 con el negocio; la tarjeta acumula sellos por cliente.
model LoyaltyProgram {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  active         Boolean @default(true)
  stampsRequired Int
  // Premio: % de descuento del cupón emitido (100 = servicio gratis)
  rewardPercent      Int
  rewardValidityDays Int @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoyaltyCard {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String
  client     User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  stamps       Int @default(0) // sellos acumulados hacia el próximo premio
  totalStamps  Int @default(0)
  totalRewards Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, clientId])
}

// Cupón de descuento: porcentaje o importe fijo sobre el precio del servicio.
model Coupon {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code       String
  // PERCENT (value = 1..100) | FIXED (value = céntimos)
  type           String
  value          Int
  active         Boolean   @default(true)
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  expiresAt      DateTime?
  // Cupón personal (premio de fidelidad): solo puede canjearlo este cliente
  clientId String?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
}

// Bono/pack: N sesiones de un servicio a precio cerrado.
model Package {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  name       String
  sessions   Int
  priceCents Int
  // Días de validez desde la compra (null = sin caducidad)
  validityDays Int?
  active       Boolean @default(true)

  purchases ClientPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, active])
}

// Bono comprado por un cliente: saldo de sesiones canjeable al reservar.
model ClientPackage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id])
  clientId   String
  client     User     @relation(fields: [clientId], references: [id])

  remainingSessions Int
  expiresAt         DateTime?
  pricePaidCents    Int
  // CHARGED | SIMULATED | UNCOLLECTED (pendiente de cobro en persona)
  paymentStatus String  @default("UNCOLLECTED")
  paymentRef    String?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, businessId])
  @@index([businessId, createdAt])
}

// Registro de eventos de seguridad de cuentas (auditoría de accesos).
model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  // LOGIN_OK | LOGIN_FAILED | LOGOUT | REGISTER | PASSWORD_RESET_REQUESTED |
  // PASSWORD_RESET_OK | EMAIL_VERIFIED | SESSIONS_REVOKED | STAFF_INVITED
  event     String
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model StaffMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  color      String   @default("#0ea5e9")
  active     Boolean  @default(true)

  // Cuenta de acceso al portal del empleado (rol STAFF), si se ha invitado
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Horario propio; si no tiene tramos, hereda el horario del negocio
  hours        StaffHour[]
  // Servicios que realiza; sin filas = realiza todos los servicios
  services     StaffService[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  // Ausencias puntuales (vacaciones, baja): días completos sin agenda
  timeOff      StaffTimeOff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, active])
}

// Suscripción push web de un dispositivo del usuario (PWA): canal de aviso
// gratuito. endpoint es único por dispositivo/navegador; las claves cifran el
// payload (Web Push / VAPID).
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model StaffHour {
  id        String      @id @default(cuid())
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday   Int
  openTime  String
  closeTime String

  @@index([staffId, weekday])
}

// Ausencia de un empleado (vacaciones, baja, permiso): rango de días completos
// inclusivo, en fechas locales del negocio (mismo formato que Closure.date).
model StaffTimeOff {
  id        String      @id @default(cuid())
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // "YYYY-MM-DD" ambos inclusivos
  startDate String
  endDate   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([staffId, startDate, endDate])
}

model StaffService {
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Service {
  id              String  @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  color           String  @default("#6366f1")
  active          Boolean @default(true)

  appointments Appointment[]
  staff        StaffService[]
  packages     Package[]
  waitlist     WaitlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, active])
}

model BusinessHour {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // 0 = domingo … 6 = sábado (convención Date.getDay)
  weekday    Int
  // "HH:mm" en la zona horaria del negocio; varios tramos por día permitidos
  openTime   String
  closeTime  String

  @@index([businessId, weekday])
}

model Closure {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // "YYYY-MM-DD" en la zona horaria del negocio
  date       String
  reason     String?

  @@unique([businessId, date])
}

model Appointment {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  clientId   String
  client     User     @relation("ClientAppointments", fields: [clientId], references: [id])
  staffId    String?
  staff      StaffMember? @relation(fields: [staffId], references: [id])

  startAt DateTime
  endAt   DateTime

  // CONFIRMED | COMPLETED | CANCELLED | CANCELLED_LATE | NO_SHOW
  status String @default("CONFIRMED")

  // Snapshot del precio al reservar: cambios futuros de tarifa no alteran citas pasadas.
  // priceCents ya lleva el descuento aplicado; discountCents lo documenta.
  priceCents    Int
  discountCents Int     @default(0)
  chargedCents  Int     @default(0)
  notes         String?
  cancelledAt   DateTime?

  // Promoción aplicada al reservar (cupón o sesión de bono)
  couponId        String?
  coupon          Coupon?        @relation(fields: [couponId], references: [id])
  clientPackageId String?
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id])

  // Confirmación de asistencia desde el recordatorio (enlace público firmado)
  confirmationToken     String    @unique @default(cuid())
  attendanceConfirmedAt DateTime?
  // Marcador idempotente de la tarjeta de sellos: la cita selló una vez
  // (se limpia si el negocio revierte el estado COMPLETED)
  loyaltyStampedAt DateTime?

  // Serie recurrente ("todos los martes"): las citas creadas juntas comparten
  // seriesId. Cada ocurrencia sigue siendo una cita normal e independiente.
  seriesId String?

  // Resultado del cobro del cargo (si lo hubo):
  // NONE | CHARGED | SIMULATED | CHARGE_FAILED | UNCOLLECTED
  paymentStatus String  @default("NONE")
  paymentRef    String?

  // Forma en que se cobró: CASH | CARD_TERMINAL | CARD_ONLINE (null si aún no cobrada).
  // CASH/CARD_TERMINAL las registra el negocio al completar (cobro presencial);
  // CARD_ONLINE la fija el sistema cuando el no-show se cobra con la tarjeta guardada.
  paymentMethod String?

  // Señal cobrada al reservar (si el negocio la exige):
  // depositStatus: NONE | CHARGED | SIMULATED | REFUNDED
  // Se reembolsa al cancelar en plazo; en tardía/no-show se descuenta del cargo.
  depositCents  Int     @default(0)
  depositStatus String  @default("NONE")
  depositRef    String?

  notifications Notification[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?

  @@index([businessId, startAt])
  @@index([clientId, startAt])
  @@index([businessId, status, startAt])
  @@index([staffId, startAt])
  // Cupo mensual del plan: se cuenta por createdAt DENTRO de la transacción de
  // reserva (bajo el advisory lock); sin este índice escanearía el histórico
  // completo del negocio en el camino caliente.
  @@index([businessId, createdAt])
  @@index([seriesId])
}

// Factura fiscal emitida por un cobro de cita: snapshot legal INMUTABLE con
// numeración correlativa sin huecos por (negocio, serie, año). La serie F es
// la normal; la R es la rectificativa (importes en negativo) que anula una F
// cuando la cita se revierte. Las facturas nunca se borran.
model Invoice {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  series        String   @default("F")
  year          Int
  number        Int
  code          String
  issuedAt      DateTime
  // Snapshot en el momento de emisión (el negocio o la cita pueden cambiar
  // después; la factura no)
  businessName    String
  businessTaxId   String?
  businessAddress String?
  clientName      String
  clientEmail     String
  concept         String
  currency        String
  totalCents      Int
  baseCents       Int
  taxCents        Int
  taxPercent      Int
  // ISSUED | RECTIFIED (anulada por una rectificativa)
  status       String  @default("ISSUED")
  rectifiesId  String? @unique
  createdAt    DateTime @default(now())

  @@unique([businessId, series, year, number])
  @@index([businessId, issuedAt])
  @@index([appointmentId])
}

// Contador correlativo por (negocio, serie, año): la asignación del número y
// la inserción de la factura hacen commit atómico bajo un advisory lock.
model InvoiceCounter {
  businessId String
  series     String
  year       Int
  nextNumber Int    @default(1)

  @@id([businessId, series, year])
}

// Reseña post-cita: solo el cliente de una cita COMPLETED, una por cita.
model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId      String
  client        User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // 1-5 estrellas
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
}

// Contador de rate limiting por ventana fija, compartido entre instancias
// (en serverless la memoria de proceso no protege entre réplicas).
// windowStart es el epoch ms del inicio de la ventana.
model RateLimitCounter {
  key         String
  windowStart BigInt
  count       Int    @default(1)

  @@id([key, windowStart])
  // La limpieza del cron borra por windowStart < corte; el PK compuesto no
  // sirve para ese rango (windowStart es la 2ª columna).
  @@index([windowStart])
}

// Outbox de notificaciones: cada mensaje se persiste y un worker/cron lo
// despacha cuando vence (scheduledFor). Reintentos con backoff simple.
model Notification {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // EMAIL | SMS | WHATSAPP
  channel String
  // BOOKING_CONFIRMED | REMINDER | CANCELLED
  template String
  recipient String
  subject   String?
  body      String

  // PENDING | SENT | FAILED | SKIPPED
  status       String    @default("PENDING")
  scheduledFor DateTime
  attempts     Int       @default(0)
  lastError    String?
  providerRef  String?
  sentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([businessId, createdAt])
  @@index([appointmentId])
  @@index([channel, status, sentAt])
}

// Lista de espera: un cliente se apunta para un servicio en un día concreto
// cuando no hay hueco. Al cancelarse una cita de ese negocio+servicio+día se
// avisa a los que esperan (notifyWaitlistForFreedSlot). desiredDate es la fecha
// de calendario "YYYY-MM-DD" en la zona del negocio.
model WaitlistEntry {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientId    String
  client      User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Preferencia opcional de profesional; null = cualquiera.
  staffId     String?
  staff       StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  desiredDate String // "YYYY-MM-DD" en la zona del negocio
  // WAITING | NOTIFIED | CANCELLED
  status     String    @default("WAITING")
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  // Búsqueda al liberarse un hueco y listado del cliente.
  @@index([businessId, serviceId, desiredDate, status])
  @@index([clientId, status])
}

// Deduplicación de webhooks entrantes (Stripe). Stripe reintenta y reordena
// eventos: guardamos el id del evento antes de procesarlo para no aplicar dos
// veces el mismo cambio (cobros, cambios de suscripción). La PK sobre eventId
// hace atómico el "reclamar" el evento vía la violación de unicidad.
model ProcessedWebhookEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Nota privada del negocio sobre un cliente (CRM): preferencias, avisos,
// historial cualitativo. Solo visible para el negocio que la escribió.
model ClientNote {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String
  client     User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Nombre de quien la escribió (snapshot; sin FK para sobrevivir a bajas)
  authorName String?
  text       String
  createdAt  DateTime @default(now())

  @@index([businessId, clientId, createdAt])
}

// Campaña de marketing a la cartera de clientes del negocio: se resuelve el
// segmento, se encolan los envíos en el outbox y queda el histórico aquí.
model Campaign {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // ALL | NEW | LOYAL | INACTIVE (ver src/lib/domain/campaigns.ts)
  segment        String
  // EMAIL | WHATSAPP | SMS
  channel        String
  subject        String?
  body           String
  recipientCount Int
  createdAt      DateTime @default(now())

  @@index([businessId, createdAt])
}

// Ajustes económicos de la plataforma (fila única id="platform"): costes que
// el super-admin edita desde el panel para que el beneficio se calcule solo.
// Importes en céntimos y comisión en basis points (140 = 1,40 %): sin floats.
model PlatformSetting {
  id                    String   @id @default("platform")
  fixedMonthlyCostCents Int      @default(0)
  whatsappMsgCostCents  Int      @default(5)
  smsMsgCostCents       Int      @default(8)
  stripeFeeBps          Int      @default(140)
  stripeFeeFixedCents   Int      @default(25)
  updatedAt             DateTime @updatedAt
}
