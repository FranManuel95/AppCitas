DATABASE_URL="file:./dev.db"

# Tope de conexiones del pool de Postgres por instancia. Por defecto 1, lo
# correcto en serverless con el transaction pooler de Supabase (pgbouncer).
# En un VPS de proceso unico puedes subirlo (p. ej. 5-10). Ignorado en SQLite.
# Con concurrencia in-function (Vercel Fluid) sube este valor o fija la
# concurrencia de las funciones a 1 (ver DEPLOY.md).
PG_POOL_MAX="1"

# Tope de espera (ms) para obtener una conexion del pool antes de fallar. Evita
# que una peticion se cuelgue indefinidamente si el pool esta saturado (max=1 y
# concurrencia in-function). 0 = sin tope (comportamiento pg por defecto).
PG_CONNECT_TIMEOUT_MS="10000"

# Obligatorio en produccion: cadena aleatoria larga (openssl rand -base64 32)
AUTH_SECRET=""

# URL publica de la app (para los enlaces de confirmacion de asistencia)
APP_BASE_URL="http://localhost:3000"

# Opcional: webhook al que el logger publica cada error (Slack o endpoint propio)
# para alertas sin montar Sentry. Fire-and-forget; ver src/lib/logger.ts. Para
# Sentry u otro SDK, usa setErrorSink(...) en instrumentation.ts.
ERROR_WEBHOOK_URL=""

# CSP: por defecto la Content-Security-Policy va en report-only (no bloquea,
# solo reporta a /api/csp-report). Pon "true" para FORZARLA (bloquear).
# Valida antes en staging: Stripe.js se carga en cliente y es sensible a la CSP.
CSP_ENFORCE=""

# Protege el endpoint de cron POST /api/jobs/notifications
CRON_SECRET=""

# Multiplicador de los limites de rate limiting. Default 1 (limites normales).
# Solo se sube en la suite E2E para no chocar con los limites. NO lo pongas en
# produccion: dejalo sin definir. Ver src/lib/rate-limit.ts.
RATE_LIMIT_MULTIPLIER=""

# --- Pagos (Stripe) ---------------------------------------------------------
# Sin claves, la pasarela funciona en modo simulado (solo desarrollo).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Id del precio (recurrente) de la suscripcion Pro B2B que paga el negocio.
# El "modo simulado" (activa Pro sin cobrar) es SOLO desarrollo. En produccion,
# sin STRIPE_SECRET_KEY la simulacion aborta con error; y con Stripe configurado
# pero sin este price, el upgrade a Pro lanza BILLING_PRICE_MISSING (500). Es
# obligatorio si vas a cobrar el plan Pro a los negocios.
STRIPE_PRICE_PRO=""
# Stripe Connect (cobros B2C que van a la cuenta del negocio): comision de la
# plataforma sobre cada cobro, en %. 0 = el negocio recibe el importe integro.
STRIPE_PLATFORM_FEE_PERCENT="0"

# --- Google Calendar (OAuth) -------------------------------------------------
# Proyecto en console.cloud.google.com con la API de Calendar activada.
# Redirect URIs autorizadas: ${APP_BASE_URL}/api/admin/calendar/google/callback
# y ${APP_BASE_URL}/api/staff/calendar/google/callback.
# Sin claves, la conexion funciona en modo simulado (solo desarrollo).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (SMTP generico: Brevo, Resend, Mailgun, Gmail app password...) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AppCitas <no-reply@tudominio.com>"

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- WhatsApp ----------------------------------------------------------------
# Via conmutable SOLO por env: auto | cloud | ultramsg | evolution | off.
# "auto" (default): gana el primero configurado (oficial primero). Un valor
# concreto FUERZA esa via; "off" apaga el canal aunque haya claves.
WHATSAPP_PROVIDER=""
# Via CLOUD (RECOMENDADA): API oficial de WhatsApp Business (Meta Cloud API).
# Sin riesgo de baneo. Numero unico de la plataforma que envia "de parte del
# negocio" (los textos ya nombran al negocio). Guia: INTEGRACIONES-EXTERNAS §2.
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""
# Plantillas aprobadas en Meta (OBLIGATORIAS fuera de la ventana de 24 h, es
# decir, para recordatorios y avisos programados). Nombre de la plantilla por
# tipo de mensaje; vacia = ese tipo sale como texto libre (solo llega dentro
# de ventana). Contrato de variables de TODAS las plantillas:
#   {{1}} cliente · {{2}} servicio · {{3}} negocio · {{4}} fecha y hora
#   {{5}} enlace de gestion de la cita
WHATSAPP_CLOUD_TEMPLATE_BOOKING_CONFIRMED=""
WHATSAPP_CLOUD_TEMPLATE_REMINDER=""
WHATSAPP_CLOUD_TEMPLATE_CANCELLED=""
WHATSAPP_CLOUD_TEMPLATE_NO_SHOW=""
WHATSAPP_CLOUD_TEMPLATE_WINBACK=""
# Codigo de idioma de las plantillas tal y como esta en Meta (es, es_ES, en...)
WHATSAPP_CLOUD_TEMPLATE_LANG=""
# Via ULTRAMSG: hosted, se configura en minutos escaneando un QR (WhatsApp Web
# por detras: riesgo de baneo del numero; solo para arrancar barato)
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""
# Via EVOLUTION: autoalojado sobre Baileys, GRATIS; Docker en un VPS (mismo
# riesgo de baneo que UltraMsg)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Respaldo opcional entre canales: si un canal distinto del email agota sus
# reintentos, encola un email con el mismo aviso (salvo que el fan-out ya
# hubiera enviado email). Por defecto apagado: enviar por varios canales a la
# vez ya es la redundancia estandar.
NOTIFY_FALLBACK_EMAIL=""

# --- Push web (PWA) -----------------------------------------------------------
# Avisos GRATIS en el navegador/movil del cliente (recordatorios sin coste).
# Genera el par de claves una vez con:  npx web-push generate-vapid-keys
# VAPID_SUBJECT: mailto: de contacto que exige el estandar Web Push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@tudominio.com"

# Docker Compose (opcion B de DEPLOY.md)
POSTGRES_PASSWORD=""

# --- Datos del titular para las paginas legales (LSSI-CE / RGPD) -------------
# Rellenan los huecos de /legal/aviso, /legal/privacidad y /legal/terminos sin
# tocar codigo. Los que se dejen vacios se muestran como "[pendiente]".
# El texto legal es una plantilla base: revisalo con asesoria juridica.
LEGAL_COMPANY_NAME=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
LEGAL_CITY=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CONTACT_PHONE=""
LEGAL_LAST_UPDATED=""
# Opcionales (registro mercantil solo si eres sociedad; nombres de proveedores
# para la clausula de destinatarios de la politica de privacidad):
LEGAL_REGISTRY=""
LEGAL_SMTP_PROVIDER=""
LEGAL_WHATSAPP_PROVIDER=""
LEGAL_HOSTING=""
