DATABASE_URL="file:./dev.db"

# Tope de conexiones del pool de Postgres por instancia. Por defecto 1, lo
# correcto en serverless con el transaction pooler de Supabase (pgbouncer).
# En un VPS de proceso unico puedes subirlo (p. ej. 5-10). Ignorado en SQLite.
# Con concurrencia in-function (Vercel Fluid) sube este valor o fija la
# concurrencia de las funciones a 1 (ver DEPLOY.md).
PG_POOL_MAX="1"

# Tope de espera (ms) para obtener una conexion del pool antes de fallar. Evita
# que una peticion se cuelgue indefinidamente si el pool esta saturado (max=1 y
# concurrencia in-function). 0 = sin tope (comportamiento pg por defecto).
PG_CONNECT_TIMEOUT_MS="10000"

# Obligatorio en produccion: cadena aleatoria larga (openssl rand -base64 32)
AUTH_SECRET=""

# URL publica de la app (para los enlaces de confirmacion de asistencia)
APP_BASE_URL="http://localhost:3000"

# Opcional: webhook al que el logger publica cada error (Slack o endpoint propio)
# para alertas sin montar Sentry. Fire-and-forget; ver src/lib/logger.ts. Para
# Sentry u otro SDK, usa setErrorSink(...) en instrumentation.ts.
ERROR_WEBHOOK_URL=""

# CSP: por defecto la Content-Security-Policy va en report-only (no bloquea,
# solo reporta a /api/csp-report). Pon "true" para FORZARLA (bloquear).
# Valida antes en staging: Stripe.js se carga en cliente y es sensible a la CSP.
CSP_ENFORCE=""

# Protege el endpoint de cron POST /api/jobs/notifications
CRON_SECRET=""

# --- Pagos (Stripe) ---------------------------------------------------------
# Sin claves, la pasarela funciona en modo simulado (solo desarrollo).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Id del precio (recurrente) de la suscripcion Pro B2B que paga el negocio.
# Sin el, la facturacion B2B corre en modo simulado (activa Pro sin cobrar).
STRIPE_PRICE_PRO=""

# --- Email (SMTP generico: Brevo, Resend, Mailgun, Gmail app password...) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AppCitas <no-reply@tudominio.com>"

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- WhatsApp (elige UNA opcion; sin API oficial de WhatsApp Business) ------
# Opcion A: UltraMsg (hosted, se configura en minutos escaneando un QR)
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""
# Opcion B: Evolution API (autoalojado sobre Baileys, GRATIS; Docker en un VPS)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Docker Compose (opcion B de DEPLOY.md)
POSTGRES_PASSWORD=""

# --- Datos del titular para las paginas legales (LSSI-CE / RGPD) -------------
# Rellenan los huecos de /legal/aviso, /legal/privacidad y /legal/terminos sin
# tocar codigo. Los que se dejen vacios se muestran como "[pendiente]".
# El texto legal es una plantilla base: revisalo con asesoria juridica.
LEGAL_COMPANY_NAME=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
LEGAL_CITY=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CONTACT_PHONE=""
LEGAL_LAST_UPDATED=""
# Opcionales (registro mercantil solo si eres sociedad; nombres de proveedores
# para la clausula de destinatarios de la politica de privacidad):
LEGAL_REGISTRY=""
LEGAL_SMTP_PROVIDER=""
LEGAL_WHATSAPP_PROVIDER=""
LEGAL_HOSTING=""
