DATABASE_URL="file:./dev.db"

# Tope de conexiones del pool de Postgres por instancia. Por defecto 1, lo
# correcto en serverless con el transaction pooler de Supabase (pgbouncer).
# En un VPS de proceso unico puedes subirlo (p. ej. 5-10). Ignorado en SQLite.
PG_POOL_MAX="1"

# Obligatorio en produccion: cadena aleatoria larga (openssl rand -base64 32)
AUTH_SECRET=""

# URL publica de la app (para los enlaces de confirmacion de asistencia)
APP_BASE_URL="http://localhost:3000"

# Protege el endpoint de cron POST /api/jobs/notifications
CRON_SECRET=""

# --- Pagos (Stripe) ---------------------------------------------------------
# Sin claves, la pasarela funciona en modo simulado (solo desarrollo).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Id del precio (recurrente) de la suscripcion Pro B2B que paga el negocio.
# Sin el, la facturacion B2B corre en modo simulado (activa Pro sin cobrar).
STRIPE_PRICE_PRO=""

# --- Email (SMTP generico: Brevo, Resend, Mailgun, Gmail app password...) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AppCitas <no-reply@tudominio.com>"

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- WhatsApp (elige UNA opcion; sin API oficial de WhatsApp Business) ------
# Opcion A: UltraMsg (hosted, se configura en minutos escaneando un QR)
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""
# Opcion B: Evolution API (autoalojado sobre Baileys, GRATIS; Docker en un VPS)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Docker Compose (opcion B de DEPLOY.md)
POSTGRES_PASSWORD=""
